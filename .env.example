# Root docker-compose defaults; copy service-specific examples for local services.
COMPOSE_PROJECT_NAME=campusshield
MONGO_INITDB_DATABASE=campusshield
MONGODB_URI=mongodb://mongo:27017/campusshield
REDIS_URL=redis://redis:6379
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
PYTHON_ANALYTICS_URL=http://analytics:8000
ANALYTICS_SECRET=replace-with-local-analytics-secret
JWT_SECRET=replace-with-long-random-local-secret
